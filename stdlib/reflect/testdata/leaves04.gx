	// 			{1, 1, 1},
	// 		},
	// 		b: [4]float32{1, 1, 1, 1},
	// 	},
	// 	l2: Linear{
	// 		w: [2][3]float32{
	// 			{1, 1, 1},
	// 			{1, 1, 1},
	// 		},
	// 		b: [4]float32{1, 1, 1, 1},
	// 	},
	// 	s: [3]float32{1, 1, 1},
	// }
}
