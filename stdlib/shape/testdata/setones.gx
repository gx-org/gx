package setones

import "shape"

// No runtime test function

//gx:compeval
func TestSome() []int {
	axes := []int{3, 4, 5, 6}
	return shape.AxesSetOnes(axes, 1, 3)
	// Want:
	// []int{3, 1, 5, 1}
}

//gx:compeval
func TestNone() []int {
	axes := []int{3, 4, 5, 6}
	return shape.AxesSetOnes(axes)
	// Want:
	// []int{3, 4, 5, 6}
}

//gx:compeval
func TestAll() []int {
	axes := []int{3, 4, 5, 6}
	return shape.AxesSetOnes(axes, 0, 1, 2, 3)
	// Want:
	// []int{1, 1, 1, 1}
}
