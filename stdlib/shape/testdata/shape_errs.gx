package shape_errs

import "shape"

func testBroadcastIncorrectNumberOfArgument() [4][3]float32 {
	return shape.Broadcast( // ERROR too many arguments in call to shape.Broadcast
		[]int{4, 3},
		[1][3]float32{{4, 5, 6}},
		false,
	)
}

func testBroadcastIncorrectArgumentType() [4][3]float32 {
	return shape.Broadcast( // ERROR too many arguments in call to shape.Broadcast
		[]int{4, 3},
		[1][3]float32{{4, 5, 6}},
	)
}

func testBroadcastIncorrectNumberOfAxes() [4][3][6]float32 {
	return shape.Broadcast[[]int{4, 3, 6}]( // ERROR cannot broadcast array from [1 3] to [4 3 6] axes (expect the same number)
		[1][3]float32{{4, 5, 6}},
	)
}

func testSplitWithWrongArgCount() [3]float32 {
	return shape.Split([3]float32{1, 2, 3}) // ERROR in call to shape.Split, cannot infer type Axis,NumSplit
}

func testSplitWithOutOfBoundsAxis() []float32 {
	return shape.Split[1][2]([3]float32{1, 2, 3}) // ERROR split axis 1 out of bound for array with 1 axes
}

func testSplitWithIntNumSplit(a int64) []float32 {
	return shape.Split(0, [3]float32{1, 2, 3}, a) // ERROR too many arguments in call to shape.Split
}

func testSplitWithIntAxisIndex(a int64) []float32 {
	return shape.Split(a, [3]float32{1, 2, 3}, 2) // ERROR too many arguments in call to shape.Split
}
