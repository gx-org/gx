package einsum03

import "num"

func TestEinsumCrossProduct() [2][2][2]float32 {
	// Cross-product matrix multiply: contract LHS axis 2 with RHS axis 0.
	x := [2][2][2]float32{{{1, 2}, {3, 4}}, {{4, 3}, {2, 1}}}
	y := [2][2]float32{{1, 0}, {0, 1}}
	return num.Einsum[[]int{2}][[]int{}][[]int{0}][[]int{}](x, y)
	// Want:
	// [2][2][2]float32{
	// 	{
	// 		{1, 2},
	// 		{3, 4},
	// 	},
	// 	{
	// 		{4, 3},
	// 		{2, 1},
	// 	},
	// }
}
