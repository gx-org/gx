package einsum01batched

import "num"

func TestEinsum() [2]float32 {
	// Batched dot product: contracting LHS/RHS axis 1, batch LHS/RHS axis 0.
	x := [2][3]float32{{1, 2, 3}, {4, 5, 6}}
	y := [2][3]float32{{7, 8, 9}, {1, 2, 3}}
	return num.Einsum[[]int{1}][[]int{0}][[]int{1}][[]int{0}](x, y)
	// Want:
	// [2]float32{50, 32}
}
