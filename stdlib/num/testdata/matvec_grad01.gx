package matvec_grad01

import (
	"math/grad"
	"num"
)

func TestMatVecMulGrad() ([3]float64, [3][2]float64, [2]float64) {
	vjp := grad.Reverse(num.MatVecMul)
	x := [3][2]float64{
		{2, 3},
		{5, 7},
		{11, 13},
	}
	y := [2]float64{17, 19}
	z, bckX, bckY := vjp(x, y)
	res := [3]float64{23, 29, 31}
	return z, bckX(res), bckY(res)
	// Want:
	// 0: [3]float64{91, 218, 434}
	// 1: [3][2]float64{
	// 	{391, 437},
	// 	{493, 551},
	// 	{527, 589},
	// }
	// 2: [2]float64{532, 675}
}
