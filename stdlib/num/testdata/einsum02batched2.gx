package einsum02batched2

import "num"

func TestEinsum() [2][2][2]float64 {
	// Batched matrix multiply: contract LHS axis 2 with RHS axis 1, batch LHS/RHS axis 0.
	x := [2][2][1]float64{{{1}, {2}}, {{3}, {4}}}
	y := [2][1][2]float64{{{5, 6}}, {{7, 8}}}
	return num.Einsum[[]int{2}][[]int{0}][[]int{1}][[]int{0}](x, y)
	// Want:
	// [2][2][2]float64{
	// 	{
	// 		{5, 6},
	// 		{10, 12},
	// 	},
	// 	{
	// 		{21, 24},
	// 		{28, 32},
	// 	},
	// }
}
