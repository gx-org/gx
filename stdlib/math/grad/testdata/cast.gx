package cast

import "math/grad"

func F(x [6]float32) [2][3]float64 {
	return ([2][3]float64)(2 * x)
}

func TestCastGrad() ([2][3]float64, [6]float32) {
	vjpF := grad.Reverse(F)
	trace(vjpF)
	y, bck := vjpF([6]float32{1, 2, 3, 4, 5, 6})
	return y, bck([2][3]float64{
		{10, 20, 30},
		{40, 50, 60},
	})
	// Want:
	// 0: [2][3]float64{
	// 	{2, 4, 6},
	// 	{8, 10, 12},
	// }
	// 1: [6]float32{20, 40, 60, 80, 100, 120}
	// Trace:
	// cast.gx:0
	// 	func(x [6]float32) ([2][3]float64, func(res [2][3]float64) [6]float32) {
	// 		fwd0 := 2*x
	// 		fwd1 := [2][3]float64(fwd0)
	// 		selfVJPFunc := func(res [2][3]float64) [6]float32 {
	// 			bck1 := [6]float32(res)
	// 			bck0y := 2*bck1
	// 			return bck0y
	// 		}
	// 		return fwd1, selfVJPFunc
	// 	}
}
