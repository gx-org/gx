package method

import "math/grad"

type S struct {
	a float32
}

func (s S) f(x float32) float32 {
	return x * s.a
}

func TestMethod() (float32, S, float32) {
	s := S{a: 3}
	vjpF := grad.Reverse(s.f)
	trace(vjpF)
	y, bckS, bckX := vjpF(2)
	res := float32(5)
	return y, bckS(res), bckX(res)
