package linear

import (
	"math/grad"
	"num"
	"rand"
	"reflect"
)

type Linear[Size int] struct {
	Weights [Size]float32
	Bias    float32
}

func (l Linear[Size]) forward(x [Size]float32) float32 {
	return num.Dot(l.Weights, x) + l.Bias
}

func loss[Size int](l Linear[Size], x [Size]float32, y float32) float32 {
	err := l.forward(x) - y
	return err * err
}

func sgd[Size int](params, grads Linear[Size], lr float32) Linear[Size] {
	for _, k := range reflect.Arrays[Linear[Size], float32]() {
		params[k] -= lr * grads[k]
	}
	return params
}

func Test() Linear[3] {
	target := Linear[3]{Weights: [3]float32{2, 3, 4}, Bias: 2}
	learner := Linear[3]{}
	_, x := rand.New(rand.NewSource(0)).Float32[[]int{3}]()
	want := target.forward(x)
	_, backward, _, _ := grad.Reverse(loss)(learner, x, want)
	g := backward(1)
	return sgd(learner, g, 0.01)
	// Want:
	// Linear[3]{
	// 	Weights: [3]float32{0.027525, 0.032956, 0.054817},
	// 	Bias: float32(0.108677),
	// }
}
