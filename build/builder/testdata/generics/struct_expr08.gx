package struct_expr08

type S[Size int] struct {
	a [Size]float32
}

type Pair[A, B any] struct {
	a A
	b B
}

func id[T any](x T) T {
	return x
}

func Test() Pair[S[2], S[3]] {
	p := Pair[S[2], S[3]]{a: S[2]{a: [2]float32{1, 2}}, b: S[3]{a: [3]float32{3, 4, 5}}}
	return id[Pair[S[2], S[3]]](p)
	// Want:
	// Pair[S[2], S[3]]{
	// 	a: S[2]{
	// 		a: [2]float32{1, 2},
	// 	},
	// 	b: S[3]{
	// 		a: [3]float32{3, 4, 5},
	// 	},
	// }
}
