package struct_expr07

type S[Size int] struct {
	a [Size]float32
}

type Outer[T any] struct {
	inner T
}

func id[T any](x T) T {
	return x
}

func Test() Outer[S[3]] {
	return id[Outer[S[3]]](Outer[S[3]]{inner: S[3]{a: [3]float32{1, 2, 3}}})
	// Want:
	// Outer[S[3]]{
	// 	inner: S[3]{
	// 		a: [3]float32{1, 2, 3},
	// 	},
	// }
}
