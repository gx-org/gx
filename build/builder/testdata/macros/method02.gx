package method02

import "testmacros"

type S[N int] struct {
	X [N]float32
	Y float32
}

func (s S[N]) y() float32 {
	return s.Y
}

func generic[N int](s S[N]) float32 {
	return testmacros.ID(s.y)()
}

func Test() float32 {
	return generic(S[3]{X: [3]float32{1, 2, 3}, Y: 0.5})
	// Want:
	// float32(0.5)
}
