package assign02

func TestAssignFloatNumber() [3]float64 {
	a := [3]float64{1, 2, 3}
	a = 2.5
	return a
	// Want:
	// [3]float64{2.5, 2.5, 2.5}
}

func TestAssignNegativeNumber() [2][2]int32 {
	a := [2][2]int32{}
	a = -3
	return a
	// Want:
	// [2][2]int32{
	// 	{-3, -3},
	// 	{-3, -3},
	// }
}

func TestAssignNumberExpr() [2]int64 {
	a := [2]int64{}
	a = 2 * (3 + 4)
	return a
	// Want:
	// [2]int64{14, 14}
}

const half = 0.5

func TestAssignConstant() [2]float32 {
	a := [2]float32{}
	a = half
	return a
	// Want:
	// [2]float32{0.5, 0.5}
}

func TestAssignThenAdd() [2]float32 {
	a := [2]float32{1, 2}
	a = 3
	return a + [2]float32{1, 2}
	// Want:
	// [2]float32{4, 5}
}

func assignParam(x [2]float32) [2]float32 {
	x = 4
	return x
}

func TestAssignParam() [2]float32 {
	return assignParam([2]float32{1, 2})
	// Want:
	// [2]float32{4, 4}
}

func TestAssignNamedResult() (x [3]float32) {
	x = 5
	return
	// Want:
	// [3]float32{5, 5, 5}
}
