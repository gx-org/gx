package infer05

type T[S []int] struct {
	a [S...]float32
}

func f[S []int](t T[S], x [S...]float32) [S...]float32 {
	return t.a + x
}

func g[S []int](x [S...]float32, t T[S]) [S...]float32 {
	return x + t.a
}

func h[S []int](a [S...]float32, b [S...]float32) [S...]float32 {
	t := T[S]{a: a}
	return g(f(t, b), t)
}

func Test() [2]float32 {
	return h([2]float32{1, 2}, [2]float32{10, 20})
	// Want:
	// [2]float32{12, 24}
}
