package assign02

// No runtime test function

//gx:compeval
func setOnes(axes []int, is ...int) []int {
	for _, i := range is {
		axes[i] = 1
	}
	return axes
}

//gx:compeval
func reduceAxes(axes []int, is ...int) []int {
	return axes[:len(is)]
}

func reduceMax[Axis []int, Shape []int](x [Shape...]float32) [reduceAxes(Shape, Axis...)...]float32

func broadcast[Dst []int, Src []int](x [Src...]float32) [Dst...]float32

func vjpReduceMax[Axis []int, Shape []int](x [Shape...]float32) ([reduceAxes(Shape, Axis...)...]float32, func([reduceAxes(Shape, Axis...)...]float32) [Shape...]float32) {
	fwd := reduceMax[Axis][Shape](x)
	vjp := func(res [reduceAxes(Shape, Axis...)...]float32) [Shape...]float32 {
		targetShape := setOnes(Shape, Axis...)
		d := [targetShape...]float32(res / fwd)
		return x * broadcast[Shape](d)
	}
	return fwd, vjp
}
