package matmul02

// No runtime test function

//gx:compeval
func matMulAxes(x, y []int) []int {
	require(len(x) == 2)
	require(len(y) == 2)
	require(x[1] == y[0])
	return []int{x[0], y[1]}
}

func matMul[SX, SY []int](x [unpack(SX)]float32, y [unpack(SY)]float32) [unpack(matMulAxes(SX, SY))]float32

func f[SX, SY []int](x [unpack(SX)]float32, y [unpack(SY)]float32) [unpack(matMulAxes(SX, SY))]float32 {
	return matMul(x, y)
}
