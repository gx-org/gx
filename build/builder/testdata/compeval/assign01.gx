package assign01

// No runtime test function

//gx:compeval
func setOnes(axes []int, is ...int) []int {
	for _, i := range is {
		axes[i] = 1
	}
	return axes
}

func f[Shape, Axes []int](x [Shape...]float32) [setOnes(Shape, Axes...)...]float32 {
	shape := setOnes(Shape, Axes...)
	return [shape...]float32{}
}
