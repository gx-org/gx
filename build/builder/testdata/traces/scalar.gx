package scalar

func TestTraceScalar() int64 {
	a := int64(2)
	trace(a)
	a = a + 1
	trace(a)
	return a
	// Want:
	// int64(3)
	// Trace:
	// scalar.gx:0
	// 	int64(2)
	// scalar.gx:1
	// 	int64(3)
}

func TestTraceMultipleScalars() int64 {
	a := int64(2)
	b := int64(3)
	trace(a, b)
	return a + b
	// Want:
	// int64(5)
	// Trace:
	// scalar.gx:0
	// 	int64(2)
	// 	int64(3)
}
