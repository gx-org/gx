// Math import doc.
package test

// Aliased math doc.
import m "math"

const (
	// Scale factor doc.
	Scale float32 = 2.0
	Uncommented = 1
)

// Global counter doc.
var GlobalCount int32

// Point doc.
type Point struct {
	X, Y float32
}

type (
	// Scalar alias doc.
	Scalar = float32
	// Floats doc.
	Floats interface {
		float32 | float64
	}
	EmptyStruct struct{}
	EmptyIface  interface{}
	MyAny       any
)

type EmptyWithMethod struct{}

func (EmptyWithMethod) Ping() int32 {
	return 1
}

type Meter float32

func (m Meter) Scale[T Floats](k T) (out Meter) {
	return m
}

type DocStruct struct {
	// Dim doc.
	Width, Height float32
	Depth         float32
}

type TagBox[A, B any] struct {
	First  A
	Second B
}

func (b TagBox[X, Y]) With[T Floats](k T) (X, T) {
	return b.First, k
}

func Use(x float32) float32 {
	// Local offset doc.
	var offset float32
	_ = Scale + offset
	return m.Abs(x)
}
