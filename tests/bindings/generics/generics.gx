// Package generics is used to test bindings for generics.
package generics

import "dtype"

// Floats returns an array of generic floats.
func Floats[T dtype.Floats]() [2]T {
	return [2]T{2, 3}
}

// VecF32 returns an vector of float32 given a size.
func VecF32[Size int]() [Size]float32 {
	return [Size]float32{}
}
